---
import { Image } from 'astro:assets';
import damn from '../assets/stickers/damn-im-good.png';
import pushpin from '../assets/stickers/pushpin.png';
import { LINKS } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title="About" description="About Nicolas (mrnico12), a self-taught uruguayan artist." ground="wires">
	<div class="about wrap">
		<h1 class="scrawl">about me</h1>

		<div class="layout">
			<article class="note paper">
				<Image class="pin" src={pushpin} alt="" width={64} />
				<p>My name is Nicolas</p>
				<p>
					I'm a self-taught,{' '}<a href={LINKS.uruguay} target="_blank" rel="noopener">uruguayan</a>{' '}
					artist
				</p>
				<p>I like art, videogames, collecting trinkets and treasures, bugs</p>
				<p class="love script">I love you</p>
			</article>
			<Image class="damn cutout" src={damn} alt="A round pin badge that says: Damn, I'm good" width={200} />
		</div>
	</div>
</Base>

<style>
	.about {
		padding-top: clamp(8px, 2vw, 24px);
	}

	h1 {
		font-size: clamp(2.6rem, 7vw, 4.6rem);
		rotate: -2deg;
		margin-bottom: clamp(28px, 5vw, 52px);
	}

	.layout {
		position: relative;
		max-width: 760px;
	}

	/* lined notebook paper */
	.note {
		--line-h: 2.2rem;
		position: relative;
		max-width: 620px;
		padding: calc(var(--line-h) * 1.4) clamp(20px, 4vw, 40px) var(--line-h) clamp(56px, 8vw, 84px);
		font-size: clamp(1.15rem, 2vw, 1.35rem);
		line-height: var(--line-h);
		background:
			linear-gradient(90deg, transparent calc(clamp(56px, 8vw, 84px) - 14px), rgb(223 0 29 / 0.45) 0 calc(clamp(56px, 8vw, 84px) - 12px), transparent 0),
			repeating-linear-gradient(transparent 0 calc(var(--line-h) - 1px), #9cc0ea 0 var(--line-h)),
			var(--paper);
		background-position: 0 0, 0 calc(var(--line-h) * 0.4 + 4px), 0 0;
		rotate: -1deg;
	}

	.note p {
		margin: 0 0 var(--line-h);
	}

	.note p:last-child {
		margin-bottom: 0;
	}

	.love {
		color: var(--red);
		font-size: 2.6rem;
	}

	.pin {
		position: absolute;
		top: -34px;
		left: 50%;
		width: 52px;
		height: auto;
		filter: drop-shadow(2px 4px 3px rgb(19 6 12 / 0.4));
		transform-origin: 50% 90%;
		animation: wobble 4s ease-in-out 6;
	}

	@keyframes wobble {
		50% {
			rotate: 8deg;
		}
	}

	.damn {
		--r: 12deg;
		position: absolute;
		right: 0;
		bottom: -70px;
		width: clamp(120px, 16vw, 200px);
		height: auto;
	}

	@media (max-width: 760px) {
		.damn {
			position: relative;
			right: auto;
			bottom: auto;
			margin: 28px 0 0 auto;
		}
	}
</style>
