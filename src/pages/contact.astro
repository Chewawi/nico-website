---
import { SOCIALS } from '../consts';
import Base from '../layouts/Base.astro';

const looks = [
	{ bg: 'linear-gradient(to top left, #feda75, #fa7e1e 16%, #d62976 42%, #962fbf 72%, #4f5bd5)', tilt: -2.5 },
	{ bg: '#0a66d6', tilt: 2 },
];
---

<Base title="Contact" description="Find Nicolas (mrnico12) on Instagram and Bluesky.">
	<div class="contact wrap">
		<h1>
			<span class="scrawl">Say hi</span>
			<span class="script">over here</span>
		</h1>

		<ul class="socials">
			{
				SOCIALS.map((s, i) => (
					<li>
						<a class="social" href={s.href} target="_blank" rel="noopener me" style={`--bg:${looks[i].bg};rotate:${looks[i].tilt}deg`}>
							<span class="name chunky printed">{s.name}</span>
							<span class="handle">{s.handle}</span>
						</a>
					</li>
				))
			}
		</ul>

		<p class="or">
			or leave a drawing in my <a href="/guestbook/">guestbook</a>
		</p>
	</div>
</Base>

<style>
	.contact {
		padding-top: clamp(8px, 2vw, 24px);
	}

	h1 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.35em;
		margin-bottom: clamp(36px, 6vw, 64px);
	}

	h1 .scrawl {
		font-size: clamp(2.6rem, 7vw, 4.6rem);
		rotate: -2deg;
	}

	h1 .script {
		font-size: clamp(2rem, 4vw, 3rem);
	}

	.socials {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: clamp(28px, 4vw, 48px);
		max-width: 860px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.social {
		display: grid;
		gap: 6px;
		padding: clamp(26px, 4vw, 40px) clamp(22px, 3vw, 32px);
		border: 3px solid var(--ink);
		border-radius: 14px;
		background: var(--bg);
		color: #fff;
		text-decoration: none;
		box-shadow: 6px 6px 0 var(--ink);
		transition:
			rotate 0.25s var(--ease),
			translate 0.15s,
			box-shadow 0.15s;
	}

	.social:hover,
	.social:focus-visible {
		rotate: 0deg !important;
		translate: -2px -3px;
		box-shadow: 8px 9px 0 var(--ink);
	}

	.social:active {
		translate: 3px 3px;
		box-shadow: 2px 2px 0 var(--ink);
	}

	.name {
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		text-shadow: 0.06em 0.06em 0 rgb(19 6 12 / 0.35);
	}

	.handle {
		font-weight: 700;
		font-size: 1.05rem;
		text-shadow: 0 1px 2px rgb(19 6 12 / 0.5);
	}

	.or {
		margin-top: clamp(40px, 6vw, 64px);
		font-size: 1.2rem;
	}
</style>
