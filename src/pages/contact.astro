---
import { Image } from 'astro:assets';
import pushpin from '../assets/stickers/pushpin.png';
import Socials from '../components/Socials.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Find Nicolas (mrnico12) on Instagram, Bluesky, Discord or by email." ground="sky">
	<div class="contact wrap">
		<h1 class="scrawl">say hi</h1>

		<div class="board">
			<Image class="pin" src={pushpin} alt="" width={48} />
			<Socials variant="cards" />
		</div>

		<noscript>
			<p class="nojs" id="email">the email address only shows up with javascript on (it keeps the spam bots out)</p>
		</noscript>

		<p class="or">
			or draw something in the <a href="/guestbook/">guestbook</a>
		</p>
	</div>
</Base>

<style>
	.contact {
		padding-top: clamp(8px, 2vw, 24px);
	}

	h1 {
		font-size: clamp(2.6rem, 7vw, 4.6rem);
		rotate: -3deg;
		margin-bottom: clamp(36px, 6vw, 60px);
	}

	.board {
		position: relative;
		max-width: 900px;
	}

	.pin {
		position: absolute;
		z-index: 2;
		top: -30px;
		left: 22%;
		width: 40px;
		height: auto;
		rotate: -10deg;
		filter: drop-shadow(2px 4px 3px rgb(19 6 12 / 0.35));
	}

	.nojs,
	.or {
		margin-top: clamp(40px, 6vw, 64px);
		font-size: 1.2rem;
	}
</style>
