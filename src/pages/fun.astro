---
import { Image } from 'astro:assets';
import exitSign from '../assets/stickers/exit-sign.png';
import Base from '../layouts/Base.astro';
---

<Base title="Fun" description="the fun room" noindex bare ground="none">
	<div class="room" data-room>
		<h1 class="sr-only">The fun room</h1>
		<div class="tree-wrap">
			<div class="tree-box">
				<picture>
					<source media="(prefers-reduced-motion: reduce)" srcset="/decor/deltarune-tree-still.png" />
					<img class="tree pixelated" src="/decor/deltarune-tree.gif" width="637" height="358" alt="A pixel-art tree with red and magenta leaves" />
				</picture>
				<button class="behind" type="button" data-behind aria-label="Look behind the tree"></button>
			</div>
			<div class="check pixel" aria-live="polite">
				<p data-check>* (He is behind the tree.)</p>
				<div class="choice" data-choice hidden>
					<button type="button" data-yes>Yes</button>
					<button type="button" data-no>No</button>
				</div>
			</div>
		</div>

		<a class="cutout exit" href="/" aria-label="Exit. Way out, back to the art">
			<Image src={exitSign} alt="" width={150} />
		</a>
		<button class="cutout penguin" type="button" data-egg="hello" aria-label="Penguin. Says hello">
			<img class="pixelated" src="/decor/penguin.png" alt="" width="36" height="60" />
		</button>

		<p class="credit">tree from DELTARUNE by Toby Fox · penguin from OneShot</p>
	</div>
</Base>

<script>
	// The man behind the tree, like in DELTARUNE chapter 1. He has an egg.
	const check = document.querySelector<HTMLElement>('[data-check]')!;
	const choice = document.querySelector<HTMLElement>('[data-choice]')!;
	let gone = false;
	document.querySelector('[data-behind]')!.addEventListener('click', () => {
		if (gone) return void (check.textContent = '* (Well, there is not a man here.)');
		check.textContent = '* (Well, there is a man here.)\n* (He offered you something.)';
		choice.hidden = false;
		choice.querySelector('button')!.focus();
	});
	choice.querySelector('[data-yes]')!.addEventListener('click', () => location.assign('/egg/'));
	choice.querySelector('[data-no]')!.addEventListener('click', () => {
		gone = true;
		choice.hidden = true;
		check.textContent = '* (Well, there is not a man here.)';
	});

	const room = document.querySelector<HTMLElement>('[data-room]')!;
	room.addEventListener('pointermove', (e) => {
		room.style.setProperty('--x', `${e.clientX}px`);
		room.style.setProperty('--y', `${e.clientY}px`);
	});
</script>

<style>
	:global(body) {
		background: #000;
		color: #f4ecd8;
	}

	.room {
		--x: 50vw;
		--y: 45vh;
		position: relative;
		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: 40px 20px 80px;
		overflow: hidden;
	}

	/* candlelight that follows the pointer, as on the old "second" page */
	.room::after {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 1;
		mix-blend-mode: screen;
		background: radial-gradient(380px circle at var(--x) var(--y), rgb(255 170 80 / 0.22), rgb(7 5 12 / 0) 70%);
		animation: flicker 3.4s steps(6) 8;
		pointer-events: none;
	}

	@keyframes flicker {
		20% {
			opacity: 0.8;
		}
		45% {
			opacity: 1;
		}
		60% {
			opacity: 0.85;
		}
	}

	.tree-wrap {
		position: relative;
		display: grid;
		justify-items: center;
		gap: 12px;
	}

	.tree-box {
		position: relative;
		width: min(900px, 100%);
	}

	.tree {
		width: 100%;
		height: auto;
	}

	.check {
		position: relative;
		z-index: 2;
		min-width: min(100%, 420px);
		padding: 10px 16px;
		border: 3px solid #f4ecd8;
		background: #000;
		font-size: 0.9rem;
		white-space: pre-line;
	}

	.check p {
		margin: 0;
	}

	.choice {
		display: flex;
		gap: 28px;
		margin-top: 8px;
		padding-left: 1.2em;
	}

	.choice[hidden] {
		display: none;
	}

	.choice button {
		padding: 2px 6px;
		border: 0;
		background: none;
		color: #f4ecd8;
		font: inherit;
	}

	.choice button:hover,
	.choice button:focus-visible {
		color: #ffd27a;
	}

	.choice button:hover::before,
	.choice button:focus-visible::before {
		content: '♥ ';
		color: #ff4d62;
	}

	/* an invisible spot just right of the trunk */
	.behind {
		position: absolute;
		z-index: 2;
		left: 55%;
		top: 52%;
		width: max(9%, 44px);
		height: max(24%, 44px);
		padding: 0;
		border: 0;
		background: none;
	}

	.exit {
		--r: -6deg;
		position: absolute;
		left: clamp(12px, 5vw, 60px);
		bottom: 40px;
		width: clamp(96px, 12vw, 150px);
	}

	.exit :global(img) {
		width: 100%;
		height: auto;
	}

	.penguin {
		--r: -4deg;
		filter: drop-shadow(0 0 6px rgb(255 210 122 / 0.75));
		position: absolute;
		right: clamp(16px, 8vw, 120px);
		top: 18%;
	}

	.penguin.talking {
		animation: hop 0.5s steps(2) 2;
	}

	@keyframes hop {
		50% {
			translate: 0 -8px;
		}
	}

	.credit {
		position: absolute;
		right: 16px;
		bottom: 12px;
		margin: 0;
		font-size: 0.78rem;
		color: #b9ad94;
	}

	:focus-visible {
		outline-color: #ffd27a;
	}
</style>
