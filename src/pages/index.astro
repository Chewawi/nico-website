---
import { Image } from 'astro:assets';
import pole from '../assets/pole.jpg';
import funSign from '../assets/stickers/fun-sign.png';
import sunflower from '../assets/stickers/sunflower.png';
import Gallery from '../components/Gallery.astro';
import { LINKS } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base>
	<section class="hero wrap" aria-labelledby="hello">
		<div class="hello-text">
			<h1 id="hello">
				<span class="scrawl hello-word">Hello</span>
				<span class="script friend">friend</span>
			</h1>
			<p class="intro">
				My name is Nicolas. I'm a self-taught,{' '}
				<a href={LINKS.uruguay} target="_blank" rel="noopener">uruguayan</a> 'artist'.
			</p>
			<div class="ctas">
				<a class="sticker big" style="--tilt:-2deg" href="#gallery">Wanna check my art?</a>
				<a class="sticker big" style="--tilt:1.5deg" href="/contact/">Check my socials</a>
			</div>
		</div>

		<div class="collage">
			<div class="print paper tape">
				<Image src={pole} alt="A utility pole tangled in wires, posterised mustard yellow" widths={[300, 600]} sizes="(min-width: 860px) 320px, 46vw" loading="eager" class="pixelated" />
			</div>
			<a class="cutout flower" href={LINKS.sunflower} target="_blank" rel="noopener" data-egg="flower" aria-label="A sunflower. Opens A Home For Flowers from the OMORI soundtrack on YouTube">
				<Image src={sunflower} alt="" width={180} />
			</a>
			<a class="cutout fun-sign" href="/fun/" aria-label="A light-up FUN sign. Go to the fun room">
				<Image src={funSign} alt="" width={110} />
			</a>
		</div>
	</section>

	<Gallery />
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		align-items: center;
		gap: 24px 40px;
		padding-block: clamp(12px, 3vw, 40px) clamp(48px, 7vw, 88px);
	}

	h1 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.3em;
	}

	.hello-word {
		font-size: clamp(3.4rem, 10vw, 7.5rem);
		text-transform: uppercase;
		rotate: -3deg;
	}

	.friend {
		font-size: clamp(2.6rem, 6vw, 4.4rem);
		rotate: -6deg;
		translate: 0 0.1em;
	}

	.intro {
		max-width: 30ch;
		margin: clamp(16px, 2.6vw, 28px) 0 clamp(22px, 3vw, 32px);
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		line-height: 1.45;
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 14px 18px;
	}

	.collage {
		position: relative;
		justify-self: center;
		width: min(100%, 360px);
		padding: 10px 40px 40px 0;
	}

	.print {
		padding: 10px 10px 34px;
		rotate: 3deg;
	}

	.print :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		max-height: 440px;
	}

	.flower {
		--r: -12deg;
		position: absolute;
		left: -70px;
		bottom: -6px;
		width: clamp(110px, 14vw, 170px);
	}

	.fun-sign {
		--r: 8deg;
		position: absolute;
		right: -6px;
		top: 34%;
		width: clamp(70px, 8vw, 104px);
	}

	.cutout :global(img) {
		width: 100%;
		height: auto;
	}

	/* phones: title on top, the collage tucks in beside the intro so the drawings show up sooner */
	@media (max-width: 760px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) 38%;
			grid-template-areas:
				'title title'
				'intro collage'
				'ctas collage';
			align-items: start;
			gap: 0 14px;
		}

		.hello-text {
			display: contents;
		}

		h1 {
			grid-area: title;
		}

		.intro {
			grid-area: intro;
			margin-top: 12px;
			font-size: 1.05rem;
		}

		.ctas {
			grid-area: ctas;
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}

		.ctas .sticker {
			font-size: 0.85rem;
		}

		.collage {
			grid-area: collage;
			width: 100%;
			padding: 14px 18px 0 0;
		}

		.print {
			padding: 6px 6px 20px;
		}

		.print :global(img) {
			max-height: 230px;
		}

		.flower {
			left: -28px;
			bottom: -34px;
			width: 74px;
		}

		.fun-sign {
			right: -4px;
			width: 48px;
		}
	}
</style>
