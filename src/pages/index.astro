---
import { getImage, Image } from 'astro:assets';
import pole from '../assets/pole.jpg';
import cat from '../assets/stickers/cat.png';
import funSign from '../assets/stickers/fun-sign.png';
import mushroom from '../assets/stickers/mushroom.png';
import notebook from '../assets/stickers/notebook.png';
import pushpin from '../assets/stickers/pushpin.png';
import starCard from '../assets/stickers/star-card.png';
import sunflower from '../assets/stickers/sunflower.png';
import yellowDog from '../assets/stickers/yellow-dog.png';
import Gallery from '../components/Gallery.astro';
import Socials from '../components/Socials.astro';
import { LINKS } from '../consts';
import Base from '../layouts/Base.astro';

// The straw page used his pole photo as the whole background; here it fades out before the drawings start.
const backdrop = await getImage({ src: pole, width: 600, format: 'webp' });
---

<Base>
	<div class="band" style={`--backdrop:url(${backdrop.src})`}>
		<Image class="dog" src={yellowDog} alt="" width={200} loading="eager" />
		<Image class="mushroom" src={mushroom} alt="" width={150} />

		<section class="hero wrap" aria-labelledby="hello">
			<h1 id="hello" class="title">
				<span class="scrawl hello-word">Hello</span>
				<span class="script friend">friend</span>
			</h1>

			<div class="bio">
				<Image class="bio-paper" src={notebook} alt="" width={460} loading="eager" />
				<p>
					My name is Nicolas. I'm a self-taught,{' '}
					<a href={LINKS.uruguay} target="_blank" rel="noopener">uruguayan</a> artist.
				</p>
				<a class="cutout cat" href={LINKS.uruguay} target="_blank" rel="noopener" aria-label="A yawning orange cat. Opens a clip on YouTube">
					<Image src={cat} alt="" width={120} />
				</a>
			</div>

			<div class="socials-card">
				<Image class="card-img" src={starCard} alt="" width={362} />
				<Image class="pin" src={pushpin} alt="" width={48} />
				<h2 class="card-title chunky">check my socials</h2>
				<Socials />
			</div>

			<div class="photo">
				<div class="print paper tape">
					<Image src={pole} alt="A utility pole tangled in wires, posterised mustard yellow" widths={[300, 600]} sizes="(min-width: 900px) 330px, 44vw" loading="eager" class="pixelated" />
				</div>
				<Image class="flower flower-back" src={sunflower} alt="" width={180} />
				<a class="cutout flower" href={LINKS.sunflower} target="_blank" rel="noopener" data-egg="flower" aria-label="A sunflower. Opens A Home For Flowers from the OMORI soundtrack on YouTube">
					<Image src={sunflower} alt="" width={180} />
				</a>
				<a class="cutout fun-sign" href="/fun/" aria-label="A light-up FUN sign. Go to the fun room">
					<Image src={funSign} alt="" width={110} />
				</a>
			</div>
		</section>
	</div>

	<Gallery />
</Base>

<style>
	/* Full-width strip behind the hero. Stickers can lean on its edges but never past the screen. */
	.band {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
	}

	.band::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: -140px 0 -60px;
		background: var(--backdrop) 50% 30% / cover;
		background-position-y: calc(30% + var(--drift-y, 0px) * 0.4);
		image-rendering: pixelated;
		opacity: 0.4;
		mix-blend-mode: multiply;
		mask-image: linear-gradient(#000 50%, transparent);
		pointer-events: none;
	}

	:root.dark-world .band::before {
		opacity: 0.25;
		mix-blend-mode: screen;
		filter: invert(1);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.62fr) minmax(0, 0.55fr) minmax(0, 0.9fr);
		grid-template-areas:
			'title title photo'
			'bio socials photo';
		align-items: start;
		gap: 0 clamp(20px, 3vw, 48px);
		padding-block: clamp(4px, 2vw, 24px) clamp(40px, 6vw, 80px);
	}

	.dog {
		position: absolute;
		z-index: 1;
		top: 6px;
		left: 14px;
		width: clamp(84px, 9vw, 140px);
		height: auto;
		rotate: -6deg;
		filter: drop-shadow(0 3px 3px rgb(19 6 12 / 0.25));
		pointer-events: none;
	}

	.mushroom {
		position: absolute;
		z-index: -1;
		left: 22px;
		bottom: -30px;
		width: clamp(70px, 8vw, 120px);
		height: auto;
		rotate: 14deg;
		filter: drop-shadow(0 3px 4px rgb(19 6 12 / 0.3));
		pointer-events: none;
	}

	.title {
		grid-area: title;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.3em;
		margin-left: clamp(60px, 8vw, 130px);
	}

	.hello-word {
		font-size: clamp(3.4rem, 10vw, 7.5rem);
		text-transform: uppercase;
		rotate: -3deg;
	}

	.friend {
		font-size: clamp(2.4rem, 5.5vw, 4.2rem);
		rotate: -6deg;
		translate: -0.4em 0.15em;
	}

	/* the bio sits on a scrap of taped notebook paper, a bit crooked */
	.bio {
		grid-area: bio;
		position: relative;
		width: min(100%, 380px);
		margin: -10px 0 0 clamp(0px, 2vw, 30px);
		rotate: 2.5deg;
	}

	.bio-paper {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 4px 6px rgb(19 6 12 / 0.25));
	}

	.bio p {
		position: absolute;
		inset: 26% 14% auto 25%;
		margin: 0;
		color: var(--ink);
		font-size: clamp(1.05rem, 1.8vw, 1.3rem);
		line-height: 1.75;
	}

	.cat {
		--r: 12deg;
		position: absolute;
		right: -6%;
		bottom: 6%;
		width: clamp(60px, 6.5vw, 92px);
	}

	/* socials pinned to the lined card with the denim stars; sizes follow the card */
	.socials-card {
		grid-area: socials;
		position: relative;
		container-type: inline-size;
		align-self: end;
		width: min(100%, 360px);
		aspect-ratio: 362 / 256;
		margin-bottom: 10px;
		rotate: -3deg;
	}

	.card-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 4px 5px rgb(19 6 12 / 0.25));
	}

	.pin {
		position: absolute;
		z-index: 2;
		top: -7%;
		left: 50%;
		width: 9cqi;
		height: auto;
		rotate: 14deg;
		filter: drop-shadow(2px 3px 2px rgb(19 6 12 / 0.35));
	}

	.card-title {
		position: absolute;
		top: 14%;
		left: 31%;
		max-width: 46%;
		margin: 0;
		font-size: 5.4cqi;
		line-height: 1.05;
		color: var(--ink);
		rotate: -2deg;
	}

	/* the four icons sit on the cream paper, clear of the stars */
	.socials-card :global(.socials) {
		--hit: 12cqi;
		position: absolute;
		top: 42%;
		left: 19%;
		gap: 1cqi;
		rotate: -2deg;
	}

	.socials-card :global(.icon) {
		width: 8.6cqi;
		height: 8.6cqi;
	}

	.photo {
		grid-area: photo;
		position: relative;
		justify-self: center;
		width: min(100%, 340px);
		margin-top: clamp(10px, 3vw, 40px);
	}

	.print {
		padding: 10px 10px 34px;
		rotate: 3deg;
	}

	.print :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		max-height: 450px;
	}

	.flower {
		--r: -12deg;
		position: absolute;
		left: -64px;
		bottom: 40px;
		width: clamp(100px, 12vw, 160px);
	}

	.flower-back {
		left: -96px;
		bottom: -10px;
		rotate: 58deg;
		scale: 0.8;
		filter: drop-shadow(0 3px 4px rgb(19 6 12 / 0.3)) saturate(0.8);
		pointer-events: none;
	}

	.fun-sign {
		--r: 8deg;
		position: absolute;
		right: -24px;
		top: 30%;
		width: clamp(56px, 8vw, 104px);
	}

	.cutout :global(img) {
		width: 100%;
		height: auto;
	}

	/* ---------- phones and narrow tablets ---------- */
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			grid-template-areas:
				'title title'
				'bio bio'
				'socials photo';
			gap: 0 14px;
		}

		.dog {
			left: auto;
			right: 6px;
			top: 0;
			width: 80px;
			rotate: 8deg;
			scale: -1 1;
		}

		.title {
			margin-left: 0;
			padding-right: 76px;
		}

		.friend {
			translate: 0.3em -0.1em;
		}

		.bio {
			justify-self: center;
			width: min(100%, 330px);
			margin: -12px 0 0;
		}

		/* a bit wider than its column so the icons stay finger-sized; it overlaps the photo like a collage */
		.socials-card {
			z-index: 1;
			align-self: center;
			width: calc(100% + 44px);
			max-width: none;
			margin: 0;
		}

		.photo {
			width: 100%;
			margin-top: 8px;
		}

		.print {
			padding: 6px 6px 20px;
		}

		.print :global(img) {
			max-height: 260px;
		}

		.flower {
			left: -26px;
			bottom: -22px;
			width: 70px;
		}

		.flower-back,
		.mushroom {
			display: none;
		}

		.fun-sign {
			right: -6px;
			width: 46px;
		}
	}

	@media (max-width: 400px) {
		.cat {
			right: 0;
		}
	}
</style>
