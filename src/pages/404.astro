---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page isn't here." noindex>
	<div class="lost wrap">
		<p class="code chunky printed">404</p>
		<div class="log paper">
			<p>&gt; Be the missing page.</p>
			<p>You are now the missing page. You look around. There is nothing here. Not even a drawing.</p>
			<p>What will you do?</p>
		</div>
		<p class="command"><a href="/">&gt; Missing page: Go back to the art. <span aria-hidden="true">==&gt;</span></a></p>
	</div>
</Base>

<style>
	.lost {
		display: grid;
		justify-items: start;
		gap: 24px;
		padding-top: clamp(12px, 3vw, 40px);
	}

	.code {
		margin: 0;
		font-size: clamp(4rem, 14vw, 9rem);
		color: var(--red);
		rotate: -3deg;
	}

	.log {
		max-width: 640px;
		padding: clamp(18px, 3vw, 28px);
		font-family: 'Courier New', monospace;
		font-weight: 700;
		font-size: 1.05rem;
	}

	.log p:last-child {
		margin: 0;
	}

	.command {
		font-family: 'Courier New', monospace;
		font-weight: 700;
		font-size: 1.15rem;
	}
</style>
