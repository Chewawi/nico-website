---
import { Image } from 'astro:assets';
import wip from '../assets/stickers/wip.png';
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page isn't here." noindex ground="wires">
	<div class="lost wrap">
		<h1 class="code chunky printed">404</h1>
		<Image class="stamp" src={wip} alt="A red rubber stamp that says: work in progress" width={420} />
		<p class="say">nothing here. maybe i haven't made it yet</p>
		<a class="sticker big" style="--tilt:-2deg" href="/">back to the drawings</a>
	</div>
</Base>

<style>
	.lost {
		position: relative;
		display: grid;
		justify-items: start;
		gap: 20px;
		padding-top: clamp(12px, 3vw, 40px);
	}

	.code {
		margin: 0;
		font-size: clamp(5rem, 18vw, 12rem);
		color: var(--red);
		rotate: -3deg;
	}

	.stamp {
		position: absolute;
		top: clamp(30px, 6vw, 90px);
		left: clamp(70px, 26vw, 380px);
		width: clamp(180px, 32vw, 420px);
		height: auto;
		rotate: -14deg;
		mix-blend-mode: multiply;
		pointer-events: none;
	}

	.say {
		margin: 0;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
	}
</style>
