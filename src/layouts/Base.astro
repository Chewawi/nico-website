---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import hoodieDog from '../assets/decor/hoodie-dog.png';
import pole from '../assets/pole.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	bare?: boolean;
	/** wallpaper texture, see global.css */
	ground?: 'plain' | 'wires' | 'sky' | 'sparkle' | 'none';
}

const { title, description = SITE_DESCRIPTION, noindex = false, bare = false, ground = 'plain' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · drawings by Nicolas`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: pole, width: 600, format: 'jpg' });
const dog = await getImage({ src: hoodieDog, width: 120, densities: [1, 2], format: 'webp' });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="theme-color" content="#e8ca0c" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<Font cssVariable="--font-text" preload={[{ weight: 400, style: 'normal' }]} />
		<Font cssVariable="--font-chunky" />
		<Font cssVariable="--font-scrawl" preload />
		<Font cssVariable="--font-script" />
		<Font cssVariable="--font-pixel" />

		<link rel="canonical" href={canonicalURL} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(og.src, Astro.site)} />
		<meta name="twitter:card" content="summary" />

		<script is:inline>
			if (sessionStorage.getItem('dark-world')) document.documentElement.classList.add('dark-world');
		</script>
	</head>
	<body data-ground={ground} data-dog={dog.src} data-dog-retina={dog.srcSet.values.at(-1)?.url}>
		<a class="skip" href="#main">Skip to content</a>
		{!bare && <Header />}
		<main id="main">
			<slot />
		</main>
		{!bare && <Footer />}
		<div class="textbox" role="status" aria-live="polite" hidden data-textbox></div>
		<script>
			import '../scripts/eggs';
		</script>
	</body>
</html>
