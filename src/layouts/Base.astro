---
import { getImage } from 'astro:assets';
import hoodieDog from '../assets/decor/hoodie-dog.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	bare?: boolean;
	/** wallpaper texture, see global.css */
	ground?: 'doodles' | 'wires' | 'sky' | 'sparkle' | 'none';
}

const { title, description = SITE_DESCRIPTION, noindex, bare = false, ground = 'doodles' } = Astro.props;
const dog = await getImage({ src: hoodieDog, width: 120, densities: [1, 2], format: 'webp' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
		<script is:inline>
			if (sessionStorage.getItem('dark-world')) document.documentElement.classList.add('dark-world');
		</script>
		<slot name="head" />
	</head>
	<body data-ground={ground} data-dog={dog.src} data-dog-retina={dog.srcSet.values.at(-1)?.url}>
		<a class="skip" href="#main">Skip to content</a>
		{!bare && <Header />}
		<main id="main">
			<slot />
		</main>
		{!bare && <Footer />}
		<div class="textbox" role="status" aria-live="polite" hidden data-textbox></div>
		<script>
			import '../scripts/eggs';
		</script>
	</body>
</html>
