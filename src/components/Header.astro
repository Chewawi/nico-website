---
import { NAV } from '../consts';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const tilts = ['-2deg', '1.5deg', '-1deg', '2.5deg'];
---

<header class="site-header wrap">
	<div class="brand-row">
		<a class="brand chunky printed" href="/">mrnico12</a>
		<button class="penguin cutout" type="button" data-egg="hello" aria-label="Penguin. Says hello">
			<img class="pixelated" src="/decor/penguin.png" alt="" width="24" height="40" />
		</button>
	</div>
	<nav aria-label="Main">
		<ul>
			{
				NAV.map((item, i) => (
					<li>
						<a
							class="sticker"
							style={`--tilt:${tilts[i % tilts.length]}`}
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: clamp(14px, 2.5vw, 26px);
	}

	.brand-row {
		display: flex;
		align-items: flex-end;
		gap: 0.6rem;
	}

	.brand {
		font-size: clamp(1.6rem, 3.4vw, 2.3rem);
		text-decoration: none;
		color: var(--on-ground);
	}

	.penguin {
		--r: 4deg;
		margin-bottom: 0.2rem;
	}

	.penguin img {
		width: 24px;
		height: 40px;
	}

	.penguin.talking {
		animation: hop 0.5s steps(2) 2;
	}

	@keyframes hop {
		50% {
			translate: 0 -6px;
		}
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.7rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 520px) {
		nav {
			width: 100%;
		}

		ul {
			display: grid;
			grid-template-columns: repeat(4, auto);
			justify-content: space-between;
		}

		.sticker {
			font-size: 0.78rem;
			padding: 0.5em 0.7em 0.42em;
		}
	}
</style>
