---
import { NAV } from '../consts';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const tilts = ['-2deg', '1.5deg', '-1deg', '2.5deg'];
---

<header class="site-header wrap">
	<a class="brand chunky printed" href="/">mrnico12</a>
	<nav aria-label="Main">
		<ul>
			{
				NAV.map((item, i) => (
					<li>
						<a
							class="sticker"
							style={`--tilt:${tilts[i % tilts.length]}`}
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: clamp(14px, 2.5vw, 26px);
	}

	.brand {
		font-size: clamp(1.6rem, 3.4vw, 2.3rem);
		text-decoration: none;
		color: var(--on-ground);
		rotate: -2deg;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.7rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 520px) {
		nav {
			width: 100%;
		}

		ul {
			display: grid;
			grid-template-columns: repeat(4, auto);
			justify-content: space-between;
		}

		.sticker {
			font-size: 0.78rem;
			padding: 0.5em 0.7em 0.42em;
		}
	}

	/* very narrow phones: let the stickers wrap instead of running off the screen */
	@media (max-width: 380px) {
		ul {
			display: flex;
			gap: 8px;
		}
	}
</style>
