---
import { getImage, Image, Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import arrows from '../assets/stickers/arrows.png';
import bubble from '../assets/stickers/bubble.png';
import cat from '../assets/stickers/cat.png';
import mushroom from '../assets/stickers/mushroom.png';
import sunflower from '../assets/stickers/sunflower.png';
import { slug } from '../lib/drawings';

// Drawings come from Nico's own repo (src/lib/drawings.ts), newest first.
const drawings = (await getCollection('drawings')).sort((a, b) => a.data.order - b.data.order);

type Shape = 'sq' | 'wide' | 'tall' | 'big' | 'bigwide';

// one column wide (sq, tall), two (wide, big) or four (bigwide)
const one = { widths: [200, 300, 400, 600], sizes: '(min-width: 1080px) 190px, (min-width: 680px) 23vw, 46vw' };
const two = { widths: [400, 600, 800], sizes: '(min-width: 1080px) 390px, (min-width: 680px) 46vw, 92vw' };
const layout: Record<Shape, { widths: number[]; sizes: string }> = {
	sq: one,
	tall: one,
	wide: two,
	big: two,
	bigwide: { widths: [600, 900, 1200], sizes: '(min-width: 1080px) 790px, 92vw' },
};

function shapeOf(ratio: number, featured: boolean): Shape {
	if (featured) return ratio >= 1.45 ? 'bigwide' : 'big';
	return ratio >= 1.6 ? 'wide' : ratio <= 0.7 ? 'tall' : 'sq';
}

const items = await Promise.all(
	drawings.map(async (drawing, i) => {
		const { image, featured, title, category, alt } = drawing.data;
		const shape = shapeOf(image.width / image.height, featured);
		// GIFs keep their animation, so they're shown as they are
		const animated = image.format === 'gif';
		const fit = (ws: number[]) => {
			const ok = ws.filter((w) => w < image.width);
			return ok.length ? [...ok, ...(ok.length < ws.length ? [image.width] : [])] : [image.width];
		};
		const large = animated ? null : await getImage({ src: image, widths: fit([1000, 1600, 2200]), format: 'webp' });
		return {
			id: drawing.id,
			image,
			title,
			alt,
			category: slug(category),
			label: category,
			shape,
			animated,
			widths: fit(layout[shape].widths),
			sizes: layout[shape].sizes,
			tilt: (((i * 37) % 7) - 3) * 0.8,
			href: large?.src ?? image.src,
			srcset: large?.srcSet.attribute ?? '',
		};
	}),
);

// one chip per folder in his repo, alphabetical; none if there's only one
const counts = new Map<string, number>();
const labels = new Map<string, string>();
for (const it of items) {
	counts.set(it.category, (counts.get(it.category) ?? 0) + 1);
	labels.set(it.category, it.label);
}
const chips = counts.size > 1 ? [...labels].map(([id, label]) => ({ id, label })).sort((a, b) => a.label.localeCompare(b.label)) : [];
---

<section id="gallery" class="gallery wrap" aria-labelledby="gallery-title">
	<div class="gallery-head">
		<h2 id="gallery-title" class="scrawl">darwings</h2>
		<p class="ask">
			<Image class="ask-bubble" src={bubble} alt="" width={300} />
			<span class="ask-text chunky">wanna check my art?</span>
			<Image class="ask-arrows" src={arrows} alt="" width={100} />
		</p>
		{
			chips.length > 0 && (
				<div class="chips" role="group" aria-label="Filter by category" data-filters hidden>
					<button class="sticker" type="button" data-filter="all" aria-pressed="true">
						all <span class="count">{items.length}</span>
					</button>
					{chips.map((c) => (
						<button class="sticker" type="button" data-filter={c.id} aria-pressed="false">
							{c.label} <span class="count">{counts.get(c.id)}</span>
						</button>
					))}
				</div>
			)
		}
	</div>
	<p class="sr-only" aria-live="polite" data-filter-status></p>

	<ul class="bento" data-gallery>
		{
			items.map((it, i) => (
				<li class={`cell ${it.shape}`} data-category={it.category}>
					<a
						class="work paper tape"
						id={`w-${it.id}`}
						href={it.href}
						style={`--tilt:${it.tilt}deg;--tape-tilt:${-it.tilt * 2}deg`}
						data-id={it.id}
						data-title={it.title}
						data-meta={it.label}
						data-alt={it.alt}
						data-srcset={it.srcset}
						data-w={it.image.width}
						data-h={it.image.height}
					>
						{it.animated ? (
							<img src={it.image.src} alt={it.alt} width={it.image.width} height={it.image.height} loading="lazy" decoding="async" />
						) : (
							<Picture
								src={it.image}
								alt={it.alt}
								formats={['avif']}
								fallbackFormat="webp"
								widths={it.widths}
								sizes={it.sizes}
								loading={i < 2 ? 'eager' : 'lazy'}
							/>
						)}
						<span class="label">
							<span class="label-title">{it.title}</span>
							<span class="label-meta">{it.label}</span>
						</span>
					</a>
				</li>
			))
		}
		{/* fills the space left at the end of the grid; gallery.ts places it */}
		<li class="cell filler" data-filler>
			<div class="missing">
				<Image class="missing-bubble" src={bubble} alt="" width={420} />
				<p>
					<span class="chunky printed">is there one missing?</span>
					<em class="too-bad">too bad</em>
					<a class="script" href="/guestbook/">(tell me)</a>
				</p>
			</div>
		</li>
	</ul>
	{/* stickers that cover any other holes the packing leaves */}
	<template data-patches>
		<Image src={sunflower} alt="" width={160} />
		<Image src={cat} alt="" width={140} />
		<Image src={mushroom} alt="" width={150} />
	</template>
</section>

<dialog class="lightbox" aria-labelledby="lb-title" data-lightbox>
	<div class="lb-stage" data-lb-stage>
		<img class="lb-img" alt="" data-lb-img />
	</div>
	<div class="lb-bar">
		<p class="lb-count pixel" data-lb-count></p>
		<div class="lb-text">
			<h2 id="lb-title" class="lb-title" data-lb-title></h2>
			<p class="lb-meta" data-lb-meta></p>
		</div>
		<div class="lb-nav">
			<button class="lb-btn" type="button" data-lb-prev aria-label="Previous artwork">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</button>
			<button class="lb-btn" type="button" data-lb-next aria-label="Next artwork">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</button>
			<button class="lb-btn" type="button" data-lb-close aria-label="Close viewer">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path></svg>
			</button>
		</div>
	</div>
</dialog>

<script>
	import '../scripts/gallery';
</script>

<style>
	.gallery {
		position: relative;
		container-type: inline-size;
		scroll-margin-top: 12px;
	}

	/* a torn sheet of darker paper under the drawings, so they sit on something calm */
	.gallery::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: -40px calc(50% - 50vw) -60px;
		background: var(--grain), var(--sheet, #d9bb08);
		background-size: 260px, auto;
		clip-path: polygon(0 18px, 4% 6px, 9% 16px, 15% 2px, 22% 14px, 30% 4px, 37% 17px, 45% 3px, 52% 15px, 60% 5px, 68% 16px, 75% 2px, 83% 13px, 90% 4px, 96% 15px, 100% 6px, 100% 100%, 0 100%);
	}

	:root.dark-world .gallery::before {
		--sheet: #1b1330;
	}

	.gallery-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 24px;
		margin-bottom: clamp(26px, 4vw, 40px);
	}

	/* "wanna check my art?" in the speech bubble, its tail and the paper arrows pointing at the drawings */
	.ask {
		position: relative;
		container-type: inline-size;
		width: clamp(150px, 17vw, 230px);
		margin: -10px auto -40px 0;
		color: var(--ink);
		rotate: -5deg;
	}

	.ask-bubble {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 4px 5px rgb(19 6 12 / 0.25));
	}

	.ask-text {
		position: absolute;
		inset: 17% 9% 34% 14%;
		display: grid;
		place-items: center;
		font-size: 9cqi;
		text-align: center;
		rotate: -6deg;
		text-shadow:
			0.07em 0.07em 0 rgb(19 6 12 / 0.28),
			-0.03em 0.1em 0 rgb(223 0 29 / 0.25);
	}

	.ask-arrows {
		position: absolute;
		left: -6%;
		top: 78%;
		width: 34%;
		height: auto;
		rotate: 120deg;
		filter: drop-shadow(0 2px 3px rgb(19 6 12 / 0.25));
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-left: auto;
	}

	@container (max-width: 619px) {
		.ask {
			margin: -6px 0 -20px auto;
		}

		.ask-arrows {
			display: none;
		}

		.chips {
			margin-left: 0;
		}
	}

	h2 {
		font-size: clamp(2.4rem, 5.5vw, 3.8rem);
		rotate: -3deg;
	}

	.chips[hidden] {
		display: none;
	}

	.chips .sticker {
		font-size: 0.8rem;
		box-shadow: 2px 2px 0 var(--ink);
	}

	.count {
		font-family: var(--font-pixel);
		font-size: 0.75em;
		opacity: 0.75;
	}

	/* bento: square cells; pieces span by aspect ratio and how featured they are */
	.bento {
		--cols: 2;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		grid-auto-rows: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols));
		grid-auto-flow: dense;
		gap: calc(var(--gap) + 6px) var(--gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@container (min-width: 620px) {
		.bento {
			--cols: 4;
		}
	}

	@container (min-width: 1000px) {
		.bento {
			--cols: 6;
		}
	}

	.cell[hidden] {
		display: none;
	}

	.wide {
		grid-column: span 2;
	}

	.tall {
		grid-row: span 2;
	}

	.big,
	.bigwide {
		grid-column: span 2;
		grid-row: span 2;
	}

	@container (max-width: 619px) {
		.bigwide {
			grid-row: span 1;
		}
	}

	@container (min-width: 620px) {
		.bigwide {
			grid-column: span 4;
		}
	}

	.work {
		position: relative;
		display: block;
		height: 100%;
		padding: clamp(6px, 4%, 12px);
		rotate: var(--tilt);
		text-decoration: none;
		transition:
			rotate 0.3s var(--ease),
			translate 0.25s var(--ease),
			box-shadow 0.25s ease;
	}

	.work:hover,
	.work:focus-visible {
		rotate: 0deg;
		translate: 0 -3px;
		box-shadow: var(--shadow-lift);
		z-index: 3;
	}

	.work:focus-visible {
		outline-offset: 4px;
	}

	.work :global(picture),
	.work :global(img) {
		width: 100%;
		height: 100%;
	}

	.work :global(img) {
		object-fit: contain;
	}

	/* hangs off the bottom of the card like a tag, so it never covers the drawing */
	.label {
		position: absolute;
		left: 10px;
		top: calc(100% - 12px);
		max-width: calc(100% - 20px);
		rotate: -1.5deg;
		box-shadow: var(--shadow);
		display: grid;
		padding: 4px 8px 5px;
		background: var(--paper);
		border: var(--line);
		border-color: var(--ink);
		color: var(--ink);
		font-size: 0.82rem;
		line-height: 1.25;
		opacity: 0;
		translate: 0 4px;
		transition:
			opacity 0.2s,
			translate 0.2s;
	}

	.label-title {
		font-weight: 700;
	}

	.label-meta {
		font-size: 0.72rem;
	}

	.work:hover .label,
	.work:focus-visible .label {
		opacity: 1;
		translate: 0 0;
	}

	@media (hover: none) {
		.label {
			display: none;
		}
	}

	/* made by gallery.ts, so they don't carry this component's scope */
	.bento :global(.patch) {
		display: grid;
		place-items: center;
		pointer-events: none;
	}

	.bento :global(.patch img) {
		width: min(70%, 150px);
		height: auto;
		rotate: var(--r, -8deg);
		filter: drop-shadow(0 3px 4px rgb(19 6 12 / 0.3));
	}

	/* the leftover space at the end of the grid holds the "is there one missing?" bubble */
	.filler {
		container-type: size;
		display: grid;
		place-items: center;
		color: var(--ink);
	}

	.missing {
		container-type: inline-size;
		position: relative;
		width: min(100cqw, 100cqh * 1.37, 440px);
		rotate: 6deg;
	}

	.missing-bubble {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 4px 5px rgb(19 6 12 / 0.25));
	}

	.missing p {
		position: absolute;
		inset: 14% 8% 30% 10%;
		display: flex;
		flex-wrap: wrap;
		align-content: center;
		justify-content: center;
		align-items: baseline;
		gap: 0 0.5em;
		margin: 0;
		font-size: clamp(0.8rem, 6.4cqi, 1.3rem);
		line-height: 1.2;
		text-align: center;
	}

	.too-bad {
		font-family: var(--font-chunky);
		color: var(--red);
		font-style: normal;
		text-transform: uppercase;
		rotate: -4deg;
	}

	.missing .script {
		font-size: 1.5em;
	}

	/* ---------- lightbox ---------- */

	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		display: none;
		grid-template-rows: 1fr auto;
		color: #f4ecd8;
		background:
			radial-gradient(60% 55% at 50% 42%, rgb(255 170 80 / 0.13), transparent 70%),
			var(--night);
	}

	.lightbox[open] {
		display: grid;
		animation: lb-in 0.22s ease-out;
	}

	.lightbox::backdrop {
		background: var(--night);
	}

	@keyframes lb-in {
		from {
			opacity: 0;
		}
	}

	.lb-stage {
		--pad: clamp(14px, 3vw, 36px);
		position: relative;
		min-height: 0;
		touch-action: pan-y;
	}

	.lb-img {
		position: absolute;
		inset: 0;
		margin: auto;
		max-width: calc(100% - 2 * var(--pad));
		max-height: calc(100% - 2 * var(--pad));
		width: auto;
		height: auto;
		background: #fff;
		box-shadow: 0 20px 60px -20px rgb(0 0 0 / 0.8);
	}

	.lb-img.swap {
		animation: lb-swap 0.2s ease-out;
	}

	@keyframes lb-swap {
		from {
			opacity: 0.2;
			scale: 0.985;
		}
	}

	.lb-bar {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px 20px;
		padding: 14px clamp(14px, 3vw, 36px) max(16px, env(safe-area-inset-bottom));
		border-top: 1px solid rgb(244 236 216 / 0.15);
	}

	.lb-count {
		margin: 0;
		font-size: 0.8rem;
		color: #ffd27a;
	}

	.lb-title {
		font-family: var(--font-chunky);
		font-size: clamp(1rem, 2vw, 1.3rem);
		text-transform: uppercase;
	}

	.lb-meta {
		margin: 2px 0 0;
		font-size: 0.9rem;
		color: #cbbfa6;
	}

	.lb-nav {
		display: flex;
		gap: 8px;
	}

	.lb-btn {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border: 2px solid #f4ecd8;
		border-radius: 50%;
		background: transparent;
		color: #f4ecd8;
		transition:
			background 0.15s,
			color 0.15s;
	}

	.lb-btn:hover {
		background: #f4ecd8;
		color: var(--night);
	}

	.lb-btn:focus-visible {
		outline-color: #ffd27a;
	}

	@media (max-width: 560px) {
		.lb-bar {
			grid-template-columns: 1fr auto;
		}

		.lb-count {
			grid-column: 1 / -1;
		}
	}
</style>
