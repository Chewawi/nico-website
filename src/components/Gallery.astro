---
import { getImage, Image, Picture } from 'astro:assets';
import bubble from '../assets/stickers/bubble.png';
import { getCollection } from 'astro:content';
import categoriesYaml from '../content/categories.yaml?raw';
import worksYaml from '../content/works/works.yaml?raw';
import { inFileOrder } from '../lib/order';

const categories = inFileOrder(await getCollection('categories'), categoriesYaml).filter((c) => !c.data.hidden);
const labels = new Map(categories.map((c) => [c.id, c.data.label]));
const works = inFileOrder(await getCollection('works'), worksYaml).filter((w) => labels.has(w.data.category.id));

type Shape = 'sq' | 'wide' | 'tall' | 'big' | 'bigwide';

const layout: Record<Shape, { widths: number[]; sizes: string }> = {
	sq: { widths: [200, 300, 400, 600], sizes: '(min-width: 1080px) 190px, (min-width: 680px) 23vw, 46vw' },
	tall: { widths: [200, 300, 400, 600], sizes: '(min-width: 1080px) 190px, (min-width: 680px) 23vw, 46vw' },
	wide: { widths: [400, 600, 800], sizes: '(min-width: 1080px) 390px, (min-width: 680px) 46vw, 92vw' },
	big: { widths: [400, 600, 800], sizes: '(min-width: 1080px) 390px, (min-width: 680px) 46vw, 92vw' },
	bigwide: { widths: [600, 900, 1200], sizes: '(min-width: 1080px) 790px, 92vw' },
};

function shapeOf(ratio: number, featured: boolean): Shape {
	if (featured) return ratio >= 1.45 ? 'bigwide' : 'big';
	return ratio >= 1.6 ? 'wide' : ratio <= 0.7 ? 'tall' : 'sq';
}

const items = await Promise.all(
	works.map(async (work, i) => {
		const { image, featured, title, year, medium, category } = work.data;
		const shape = shapeOf(image.width / image.height, featured);
		const fit = (ws: number[]) => {
			const ok = ws.filter((w) => w < image.width);
			return ok.length ? [...ok, ...(ok.length < ws.length ? [image.width] : [])] : [image.width];
		};
		const large = await getImage({ src: image, widths: fit([1000, 1600, 2200]), format: 'webp' });
		return {
			id: work.id,
			image,
			title,
			alt: work.data.alt ?? title,
			meta: [year, medium, labels.get(category.id)].filter(Boolean).join(' · '),
			category: category.id,
			shape,
			widths: fit(layout[shape].widths),
			sizes: layout[shape].sizes,
			tilt: (((i * 37) % 7) - 3) * 0.8,
			large,
		};
	}),
);

const counts = new Map<string, number>();
for (const it of items) counts.set(it.category, (counts.get(it.category) ?? 0) + 1);
const chips = categories.filter((c) => counts.has(c.id));
---

<section id="gallery" class="gallery wrap" aria-labelledby="gallery-title">
	<div class="gallery-head">
		<h2 id="gallery-title" class="scrawl">darwings</h2>
		<div class="chips" role="group" aria-label="Filter by category" data-filters hidden>
			<button class="sticker" type="button" data-filter="all" aria-pressed="true">
				All <span class="count">{items.length}</span>
			</button>
			{
				chips.map((c) => (
					<button class="sticker" type="button" data-filter={c.id} aria-pressed="false">
						{c.data.label} <span class="count">{counts.get(c.id)}</span>
					</button>
				))
			}
		</div>
	</div>
	<p class="sr-only" aria-live="polite" data-filter-status></p>

	<ul class="bento" data-gallery>
		{
			items.map((it, i) => (
				<li class={`cell ${it.shape}`} data-category={it.category}>
					<a
						class="work paper tape"
						id={`w-${it.id}`}
						href={it.large.src}
						style={`--tilt:${it.tilt}deg;--tape-tilt:${-it.tilt * 2}deg`}
						data-id={it.id}
						data-title={it.title}
						data-meta={it.meta}
						data-alt={it.alt}
						data-srcset={it.large.srcSet.attribute}
						data-w={it.image.width}
						data-h={it.image.height}
					>
						<Picture
							src={it.image}
							alt={it.alt}
							formats={['avif']}
							fallbackFormat="webp"
							widths={it.widths}
							sizes={it.sizes}
							loading={i < 2 ? 'eager' : 'lazy'}
						/>
						<span class="label">
							<span class="label-title">{it.title}</span>
							{it.meta && <span class="label-meta">{it.meta}</span>}
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<div class="missing">
		<Image class="missing-bubble" src={bubble} alt="" width={420} />
		<p>
			<span class="chunky printed">is there one missing?</span>
			<em class="too-bad">too bad</em>
			<a class="script" href="/guestbook/">(tell me)</a>
		</p>
	</div>
</section>

<dialog class="lightbox" aria-labelledby="lb-title" data-lightbox>
	<div class="lb-stage" data-lb-stage>
		<img class="lb-img" alt="" data-lb-img />
	</div>
	<div class="lb-bar">
		<p class="lb-count pixel" data-lb-count></p>
		<div class="lb-text">
			<h2 id="lb-title" class="lb-title" data-lb-title></h2>
			<p class="lb-meta" data-lb-meta></p>
		</div>
		<div class="lb-nav">
			<button class="lb-btn" type="button" data-lb-prev aria-label="Previous artwork">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</button>
			<button class="lb-btn" type="button" data-lb-next aria-label="Next artwork">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</button>
			<button class="lb-btn" type="button" data-lb-close aria-label="Close viewer">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path></svg>
			</button>
		</div>
	</div>
</dialog>

<script>
	import '../scripts/gallery';
</script>

<style>
	.gallery {
		container-type: inline-size;
		scroll-margin-top: 12px;
	}

	.gallery-head {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 14px 24px;
		margin-bottom: clamp(26px, 4vw, 40px);
	}

	h2 {
		font-size: clamp(2.4rem, 5.5vw, 3.8rem);
		rotate: -3deg;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.chips[hidden] {
		display: none;
	}

	.chips .sticker {
		font-size: 0.8rem;
		box-shadow: 2px 2px 0 var(--ink);
	}

	.count {
		font-family: var(--font-pixel);
		font-size: 0.75em;
		opacity: 0.75;
	}

	/* bento: square cells; pieces span by aspect ratio and how featured they are */
	.bento {
		--cols: 2;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		grid-auto-rows: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols));
		grid-auto-flow: dense;
		gap: calc(var(--gap) + 6px) var(--gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@container (min-width: 620px) {
		.bento {
			--cols: 4;
		}
	}

	@container (min-width: 1000px) {
		.bento {
			--cols: 6;
		}
	}

	.cell[hidden] {
		display: none;
	}

	.wide {
		grid-column: span 2;
	}

	.tall {
		grid-row: span 2;
	}

	.big,
	.bigwide {
		grid-column: span 2;
		grid-row: span 2;
	}

	@container (max-width: 619px) {
		.bigwide {
			grid-row: span 1;
		}
	}

	@container (min-width: 620px) {
		.bigwide {
			grid-column: span 4;
		}
	}

	.work {
		position: relative;
		display: block;
		height: 100%;
		padding: clamp(6px, 4%, 12px);
		rotate: var(--tilt);
		text-decoration: none;
		transition:
			rotate 0.3s var(--ease),
			translate 0.25s var(--ease),
			box-shadow 0.25s ease;
	}

	.work:hover,
	.work:focus-visible {
		rotate: 0deg;
		translate: 0 -3px;
		box-shadow: var(--shadow-lift);
		z-index: 3;
	}

	.work:focus-visible {
		outline-offset: 4px;
	}

	.work :global(picture),
	.work :global(img) {
		width: 100%;
		height: 100%;
	}

	.work :global(img) {
		object-fit: contain;
	}

	/* hangs off the bottom of the card like a tag, so it never covers the drawing */
	.label {
		position: absolute;
		left: 10px;
		top: calc(100% - 12px);
		max-width: calc(100% - 20px);
		rotate: -1.5deg;
		box-shadow: var(--shadow);
		display: grid;
		padding: 4px 8px 5px;
		background: var(--paper);
		border: var(--line);
		border-color: var(--ink);
		color: var(--ink);
		font-size: 0.82rem;
		line-height: 1.25;
		opacity: 0;
		translate: 0 4px;
		transition:
			opacity 0.2s,
			translate 0.2s;
	}

	.label-title {
		font-weight: 700;
	}

	.label-meta {
		font-size: 0.72rem;
	}

	.work:hover .label,
	.work:focus-visible .label {
		opacity: 1;
		translate: 0 0;
	}

	@media (hover: none) {
		.label {
			display: none;
		}
	}

	.missing {
		position: relative;
		width: min(100%, 420px);
		margin: clamp(20px, 3vw, 36px) 0 0 auto;
		rotate: 8deg;
		color: var(--ink);
	}

	.missing-bubble {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 4px 5px rgb(19 6 12 / 0.25));
	}

	.missing p {
		position: absolute;
		inset: 14% 8% 30% 10%;
		display: flex;
		flex-wrap: wrap;
		align-content: center;
		justify-content: center;
		align-items: baseline;
		gap: 0 0.5em;
		margin: 0;
		font-size: clamp(1rem, 2.2vw, 1.3rem);
		text-align: center;
	}

	.too-bad {
		font-family: var(--font-chunky);
		color: var(--red);
		font-style: normal;
		text-transform: uppercase;
		rotate: -4deg;
	}

	.missing .script {
		font-size: 1.5em;
	}

	/* ---------- lightbox ---------- */

	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		display: none;
		grid-template-rows: 1fr auto;
		color: #f4ecd8;
		background:
			radial-gradient(60% 55% at 50% 42%, rgb(255 170 80 / 0.13), transparent 70%),
			var(--night);
	}

	.lightbox[open] {
		display: grid;
		animation: lb-in 0.22s ease-out;
	}

	.lightbox::backdrop {
		background: var(--night);
	}

	@keyframes lb-in {
		from {
			opacity: 0;
		}
	}

	.lb-stage {
		--pad: clamp(14px, 3vw, 36px);
		position: relative;
		min-height: 0;
		touch-action: pan-y;
	}

	.lb-img {
		position: absolute;
		inset: 0;
		margin: auto;
		max-width: calc(100% - 2 * var(--pad));
		max-height: calc(100% - 2 * var(--pad));
		width: auto;
		height: auto;
		background: #fff;
		box-shadow: 0 20px 60px -20px rgb(0 0 0 / 0.8);
	}

	.lb-img.swap {
		animation: lb-swap 0.2s ease-out;
	}

	@keyframes lb-swap {
		from {
			opacity: 0.2;
			scale: 0.985;
		}
	}

	.lb-bar {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px 20px;
		padding: 14px clamp(14px, 3vw, 36px) max(16px, env(safe-area-inset-bottom));
		border-top: 1px solid rgb(244 236 216 / 0.15);
	}

	.lb-count {
		margin: 0;
		font-size: 0.8rem;
		color: #ffd27a;
	}

	.lb-title {
		font-family: var(--font-chunky);
		font-size: clamp(1rem, 2vw, 1.3rem);
		text-transform: uppercase;
	}

	.lb-meta {
		margin: 2px 0 0;
		font-size: 0.9rem;
		color: #cbbfa6;
	}

	.lb-nav {
		display: flex;
		gap: 8px;
	}

	.lb-btn {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border: 2px solid #f4ecd8;
		border-radius: 50%;
		background: transparent;
		color: #f4ecd8;
		transition:
			background 0.15s,
			color 0.15s;
	}

	.lb-btn:hover {
		background: #f4ecd8;
		color: var(--night);
	}

	.lb-btn:focus-visible {
		outline-color: #ffd27a;
	}

	@media (max-width: 560px) {
		.lb-bar {
			grid-template-columns: 1fr auto;
		}

		.lb-count {
			grid-column: 1 / -1;
		}
	}
</style>
