---
const built = new Date();
const updated = built.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<footer class="site-footer">
	<div class="wrap">
		<ul class="badges" aria-label="Web buttons">
			<li><a class="badge b-home" href="/">mrnico12<br />★ home ★</a></li>
			<li>
				<button class="badge b-viewed" type="button" data-egg="viewed" aria-live="polite">best viewed with your eyes</button>
			</li>
			<li><span class="badge b-uy">hecho en<br />uruguay ☀</span></li>
			<li><a class="badge b-gb" href="/guestbook/"><span class="blink">sign my</span>guestbook!</a></li>
		</ul>

		<div class="meta">
			<p class="counter pixel" data-counter hidden>
				you are visitor no.
				<button class="digits" type="button" data-egg="counter" data-digits aria-label="Visitor number">000000</button>
			</p>
			<button class="trinket" type="button" data-egg="trinket" aria-label="An egg" data-trinket hidden>
				<svg viewBox="0 0 12 14" width="18" height="21" shape-rendering="crispEdges" aria-hidden="true">
					<path fill="#13060c" d="M4 0h4v1H4zM2 1h2v1H2zM8 1h2v1H8zM1 2h1v2H1zM10 2h1v2h-1zM0 4h1v6H0zM11 4h1v6h-1zM1 10h1v2H1zM10 10h1v2h-1zM2 12h2v1H2zM8 12h2v1H8zM4 13h4v1H4z"></path>
					<path fill="#fff6dc" d="M4 1h4v1h2v2h1v6h-1v2H8v1H4v-1H2v-2H1V4h1V2h2z"></path>
					<path fill="#e9d6a8" d="M8 9h2v1H8zM6 11h3v1H6z"></path>
				</svg>
			</button>
		</div>

		<p class="fine">
			© {built.getFullYear()} Nicolas (mrnico12) · last updated {updated}
			<br />
			<span class="credits">the yellow dog, sunflower, signs, pins and the other stickers are found on the internet</span>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(48px, 8vw, 96px);
		padding-block: 28px 40px;
		border-top: var(--line);
		background: rgb(255 254 248 / 0.35);
	}

	:root.dark-world .site-footer {
		background: rgb(0 0 0 / 0.3);
	}

	.wrap {
		display: grid;
		gap: 18px;
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.b-home {
		background: var(--red);
		color: #fff;
	}

	.b-viewed {
		background: #000;
		color: #7dff7d;
	}

	.b-uy {
		background: linear-gradient(#fff 0 50%, #4f8fdc 50%);
		color: var(--ink);
		text-shadow: 0 0 2px #fff;
	}

	.b-gb {
		background: #ffe9f2;
		color: #b3005c;
		gap: 0;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.counter {
		margin: 0;
		font-size: 0.8rem;
	}

	.digits {
		display: inline-block;
		margin-left: 0.3em;
		padding: 2px 4px;
		border: 0;
		background: #000;
		color: #7dff7d;
		font: inherit;
		letter-spacing: 0.25em;
	}

	.trinket {
		padding: 2px;
		border: 0;
		background: none;
	}

	.trinket[hidden] {
		display: none;
	}

	.fine {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.credits {
		opacity: 0.8;
	}
</style>
