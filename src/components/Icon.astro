	],
} as const;

type IconName = keyof typeof paths;

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 28 } = Astro.props;
---

<svg
	class="icon"
	viewBox="0 0 32 32"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="2.3"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{paths[name].map((d) => <path d={d} />)}
</svg>
