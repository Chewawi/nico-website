# Copy to .env. On Vercel, set the same names in the project's environment variables instead.

# Password for /admin/. Without it nobody can get in.
ADMIN_PASSWORD=

# The guestbook database is a SQLite file by default.
# DATABASE_PATH=data/guestbook.sqlite
# On hosts without a disk (Vercel), a Turso database:
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Robot check on the guestbook (Turnstile). Off unless both are set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Build time only.
# The site's address when it isn't https://nico.kodeko.org (Vercel fills this in by itself).
# SITE=
# GitHub token to read the drawings repo, only if it is private.
# DRAWINGS_TOKEN=
# Another drawings repo or branch, or a local clone to use instead of downloading.
# DRAWINGS_REPO=MrDino127/drawings
# DRAWINGS_BRANCH=main
# DRAWINGS_DIR=
